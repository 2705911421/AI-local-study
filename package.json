{
  "name": "zhiye-local-study",
  "private": true,
  "version": "0.1.0",
  "description": "面向 Windows 的本地教材伴学工具，只依据用户导入的教材回答。",
  "author": {
    "name": "知页团队"
  },
  "copyright": "Copyright © 2026 知页团队",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "desktop:dev": "npm run build:electron && concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:4173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron .\"",
    "build": "npm run build:web",
    "build:web": "node scripts/clean.mjs build:web && cross-env ZHIYE_BUILD_TARGET=web tsc -b && cross-env ZHIYE_BUILD_TARGET=web vite build --config vite.config.ts && node scripts/check-web-build.mjs && node scripts/prepare-sites-build.mjs",
    "build:desktop-client": "node scripts/clean.mjs build:web && cross-env ZHIYE_BUILD_TARGET=desktop tsc -b && cross-env ZHIYE_BUILD_TARGET=desktop vite build --config vite.config.ts",
    "build:electron": "node scripts/clean.mjs build:electron && tsc -p tsconfig.electron.json",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "desktop:build": "npm run build:desktop-client && npm run build:electron && node scripts/build-desktop.mjs --require-signature",
    "desktop:build:unsigned": "npm run build:desktop-client && npm run build:electron && node scripts/build-desktop.mjs --unsigned",
    "preview": "cross-env ZHIYE_BUILD_TARGET=web vite preview --config vite.config.ts",
    "preview:worker": "wrangler dev --config wrangler.site.jsonc --ip 127.0.0.1 --port 4199",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json --noEmit",
    "check:repo": "node scripts/check-repository-hygiene.mjs && node scripts/check-e2e-snapshots.mjs",
    "test": "npm run test:web",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:coverage": "vitest run --config vitest.web.config.ts --coverage",
    "test:site": "node --test tests/site-worker.test.mjs",
    "test:e2e": "playwright test",
    "test:desktop": "vitest run --config vitest.electron.config.ts",
    "test:desktop:e2e": "npm run build:desktop-client && npm run build:electron && playwright test -c playwright.desktop.config.ts",
    "audit:runtime": "npm audit --omit=dev",
    "clean:test": "node scripts/clean.mjs test",
    "clean:build": "node scripts/clean.mjs build",
    "clean:release": "node scripts/clean.mjs release",
    "clean:qa": "node scripts/clean.mjs qa",
    "clean:cache": "node scripts/clean.mjs cache",
    "clean:generated": "node scripts/clean.mjs generated",
    "clean:dependencies": "node scripts/clean.mjs dependencies",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex-sdk": "0.145.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "jszip": "^3.10.1",
    "motion": "^12.42.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.2",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "archiver": "^8.0.0",
    "concurrently": "^10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.3.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0",
    "wait-on": "9.0.1",
    "wrangler": "^4.92.0"
  },
  "build": {
    "appId": "cn.zhiye.study",
    "productName": "知页",
    "compression": "maximum",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/@openai/codex-win32-x64/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**/*"
    ],
    "extraResources": [
      {
        "from": "build/runtimes",
        "to": "runtimes",
        "filter": [
          "*.zip"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "legalTrademarks": "知页",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Zhiye-${version}-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知页",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "知页"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.ZHIYE_UPDATE_URL}"
      }
    ]
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
